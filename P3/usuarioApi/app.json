{
  "expo": {
    "name": "Registro de Usuarios",
    "slug": "registro-usuarios",
    "version": "1.0.0",
    "orientation": "portrait",
    "extra": {
      "eas": {
        "projectId": "75d75e5d-2d24-4320-9b18-9d1d41d430e7"
      }
    },

    "icon": "./assets/icon.png",

    "userInterfaceStyle": "light",

    "android": {
      "package": "com.ivima.registrousuarios",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}